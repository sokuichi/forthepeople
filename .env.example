# Atlas Research local backend
PORT=4173

# Optional hybrid AI synthesis. If unset, Atlas uses deterministic synthesis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-mini
ENABLE_OPENAI_SYNTHESIS=false

# Optional credentialed provider. Leave blank to show WorldCat as "not configured".
WORLDCAT_API_URL=
WORLDCAT_API_KEY=

# Optional request identity for public scholarly APIs that recommend a User-Agent.
ATLAS_CONTACT_EMAIL=

# Optional NCBI key for higher PubMed E-utilities rate limits.
NCBI_API_KEY=
